# Environment Configuration for Cart Detective
# Copy this file to .env and fill in values as appropriate.

# General Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///data/cart_detective.db

# Large Language Model Providers
# LLM Provider selection: groq, gemini, ollama, or heuristic
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
# Groq Free Tier: 30 requests per minute, 14400 per day.
# If missing, system falls back to heuristic rule based parser.
GROQ_API_KEY=

# Optional Gemini Provider
# Gemini Free Tier: 15 requests per minute.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional Local Ollama Provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Video and Media Analysis
# YouTube Data API v3 Free Tier: 10000 quota units per day (search consumes 100 units).
# If missing, system falls back to direct youtube-transcript-api and web scraping.
YOUTUBE_API_KEY=

# Search and Discovery Providers
# SearXNG self-hosted instance (Docker Compose service name is searxng)
SEARXNG_URL=http://localhost:8080

# Brave Search API Free Tier: 2000 queries per month, 1 request per second.
# Optional fallback when SearXNG or DuckDuckGo are throttled.
BRAVE_SEARCH_API_KEY=

# Scraping and Rate Limiting
HTTP_CACHE_DIR=data/cache/http
HTTP_TIMEOUT_SECONDS=15
MAX_RETRIES_PER_DOMAIN=3
RATE_LIMIT_DELAY_SECONDS=1.0
USER_AGENT=CartDetective/0.1.0 (Autonomous Research Agent; +https://github.com/ashwinsdk/cart-detective)

# Frontend Settings (passed to Vite)
VITE_API_BASE_URL=http://localhost:8000
